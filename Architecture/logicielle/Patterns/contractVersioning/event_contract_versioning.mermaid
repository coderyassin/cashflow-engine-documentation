graph TD
    subgraph "Service Producteur"
        A[Nouvelle Fonctionnalité] --> B{Changement du Contrat?}
        B -- Oui --> C[Choisir Stratégie de Versioning]
        C --> D[Publier Événement avec Version V2]
        D --> E[(Message Broker)]
    end

    subgraph "Service Consommateur 1"
        E --> F[Consommateur Ancien]
        F --> G{Version de l'événement?}
        G -- V1 --> H[Traitement Legacy]
        G -- V2 --> I[Ignorer ou Logguer]
    end

    subgraph "Service Consommateur 2 (Mis à jour)"
        E --> J[Consommateur Mis à jour]
        J --> K{Version de l'événement?}
        K -- V1 --> L[Traitement avec Adaptateur]
        K -- V2 --> M[Nouveau Traitement]
    end

    style A fill:#3B4059,stroke:#333,stroke-width:2px
    style D fill:#5D5DE8,stroke:#333,stroke-width:2px
    style F fill:#6A7A6A,stroke:#333,stroke-width:2px
    style J fill:#6A7A6A,stroke:#333,stroke-width:2px